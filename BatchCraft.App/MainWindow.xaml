    <Geometry x:Key="IconImagesToPdfGeometry">M1,2 C1,1.45 1.45,1 2,1 L7,1 C7.55,1 8,1.45 8,2 L8,7 C8,7.55 7.55,8 7,8 L2,8 C1.45,8 1,7.55 1,7 L1,2 Z M2.2,6.8 L6.8,6.8 L5.5,5.1 L4.4,6.4 L3.5,5.3 L2.2,6.8 Z M9.5,2 L14,2 C14.55,2 15,2.45 15,3 L15,14 C15,14.55 14.55,15 14,15 L9.5,15 C8.95,15 8.5,14.55 8.5,14 L8.5,3 C8.5,2.45 8.95,2 9.5,2 Z M10,3.5 L13.5,3.5 L13.5,5.5 L10,5.5 Z M10,7.5 L13.5,7.5 L13.5,8.7 L10,8.7 Z M10,10.2 L13.5,10.2 L13.5,11.4 L10,11.4 Z</Geometry>
    <Geometry x:Key="IconMergePdfGeometry">M2,1 C1.45,1 1,1.45 1,2 L1,11 C1,11.55 1.45,12 2,12 L4,12 L4,10.5 L2.5,10.5 L2.5,2.5 L6.5,2.5 L6.5,5.5 L9.5,5.5 L9.5,6.5 L11,6.5 L11,5 L7,1 L2,1 Z M6,6 C5.45,6 5,6.45 5,7 L5,15 C5,15.55 5.45,16 6,16 L14,16 C14.55,16 15,15.55 15,15 L15,9.5 L11.5,6 L6,6 Z M11,7.2 L13.8,10 L11,10 Z M7,11 L9,11 L9,9 L10.5,9 L10.5,11 L12.5,11 L12.5,12.5 L10.5,12.5 L10.5,14.5 L9,14.5 L9,12.5 L7,12.5 Z</Geometry>
    <Geometry x:Key="IconSplitPdfGeometry">M9.6,8 L12.5,11 C13.3,11.8 13.3,13.1 12.5,13.9 C11.7,14.7 10.4,14.7 9.6,13.9 L7.5,11.8 L5.4,13.9 C4.6,14.7 3.3,14.7 2.5,13.9 C1.7,13.1 1.7,11.8 2.5,11 L5.4,8 L2.5,5 C1.7,4.2 1.7,2.9 2.5,2.1 C3.3,1.3 4.6,1.3 5.4,2.1 L7.5,4.2 L9.6,2.1 C10.4,1.3 11.7,1.3 12.5,2.1 C13.3,2.9 13.3,4.2 12.5,5 L9.6,8 Z M3.5,11.8 C3.2,12.1 3.2,12.6 3.5,12.9 C3.8,13.2 4.3,13.2 4.6,12.9 C4.9,12.6 4.9,12.1 4.6,11.8 C4.3,11.5 3.8,11.5 3.5,11.8 Z M10.4,11.8 C10.1,12.1 10.1,12.6 10.4,12.9 C10.7,13.2 11.2,13.2 11.5,12.9 C11.8,12.6 11.8,12.1 11.5,11.8 C11.2,11.5 10.7,11.5 10.4,11.8 Z</Geometry>
    <Geometry x:Key="IconRotatePdfGeometry">M8,1 C11.9,1 15,4.1 15,8 C15,9.6 14.5,11.1 13.5,12.3 L12.3,11.2 C13,10.3 13.5,9.2 13.5,8 C13.5,5 11,2.5 8,2.5 C6.3,2.5 4.8,3.3 3.8,4.5 L6,6.7 L1,6.7 L1,1.7 L2.8,3.5 C4.1,2 6,1 8,1 Z M6,7.5 L10.5,7.5 C11.1,7.5 11.5,7.9 11.5,8.5 L11.5,13.5 C11.5,14.1 11.1,14.5 10.5,14.5 L6,14.5 C5.4,14.5 5,14.1 5,13.5 L5,8.5 C5,7.9 5.4,7.5 6,7.5 Z</Geometry>
    <Geometry x:Key="IconSettingsGeometry">M8,5.2 A2.8,2.8 0 1,0 8,10.8 A2.8,2.8 0 0,0 8,5.2 Z M15.2,7.2 L13.9,7 A5.2,5.2 0 0,0 13.3,5.7 L14.2,4.6 A0.7,0.7 0 0,0 14.1,3.6 L13,2.5 A0.7,0.7 0 0,0 12,2.4 L10.9,3.3 A5.2,5.2 0 0,0 9.6,2.7 L9.4,1.4 A0.7,0.7 0 0,0 8.7,0.8 L7.3,0.8 A0.7,0.7 0 0,0 6.6,1.4 L6.4,2.7 A5.2,5.2 0 0,0 5.1,3.3 L4,2.4 A0.7,0.7 0 0,0 3,2.5 L1.9,3.6 A0.7,0.7 0 0,0 1.8,4.6 L2.7,5.7 A5.2,5.2 0 0,0 2.1,7 L0.8,7.2 A0.7,0.7 0 0,0 0.2,7.9 L0.2,9.3 A0.7,0.7 0 0,0 0.8,10 L2.1,10.2 A5.2,5.2 0 0,0 2.7,11.5 L1.8,12.6 A0.7,0.7 0 0,0 1.9,13.6 L3,14.7 A0.7,0.7 0 0,0 4,14.8 L5.1,13.9 A5.2,5.2 0 0,0 6.4,14.5 L6.6,15.8 A0.7,0.7 0 0,0 7.3,16.4 L8.7,16.4 A0.7,0.7 0 0,0 9.4,15.8 L9.6,14.5 A5.2,5.2 0 0,0 10.9,13.9 L12,14.8 A0.7,0.7 0 0,0 13,14.7 L14.1,13.6 A0.7,0.7 0 0,0 14.2,12.6 L13.3,11.5 A5.2,5.2 0 0,0 13.9,10.2 L15.2,10 A0.7,0.7 0 0,0 15.8,9.3 L15.8,7.9 A0.7,0.7 0 0,0 15.2,7.2 Z</Geometry>
    <Geometry x:Key="IconAboutGeometry">M8,1 A7,7 0 1,0 8,15 A7,7 0 0,0 8,1 Z M7.2,4.2 A0.9,0.9 0 1,1 8.8,4.2 A0.9,0.9 0 0,1 7.2,4.2 Z M7,6.5 L9,6.5 L9,11.5 L7,11.5 Z</Geometry>

    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="88"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="9"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
    <Style TargetType="TabControl"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Margin" Value="0,0,5,0"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8,8,0,0">
              <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="18,16"/></Style>
    <Style x:Key="DropZone" TargetType="Border"><Setter Property="Background" Value="{DynamicResource DropBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="18"/><Setter Property="AllowDrop" Value="True"/></Style>
    <Style x:Key="CompactDropZone" TargetType="Border"><Setter Property="Background" Value="{DynamicResource DropBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="BorderThickness" Value="1.5"/><Setter Property="CornerRadius" Value="9"/><Setter Property="Padding" Value="14,9"/><Setter Property="AllowDrop" Value="True"/></Style>
  </Window.Resources>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock FontSize="29" FontWeight="SemiBold" Text="BatchCraft"/>
        <TextBlock x:Name="SubtitleText" Foreground="{DynamicResource MutedBrush}"/>
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Border Background="{DynamicResource InputBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
          <TextBlock x:Name="VersionText" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
        </Border>
        <Button x:Name="HeaderThaiButton" Content="ไทย" Padding="10,7" Click="Thai_Click"/>
        <Button x:Name="HeaderEnglishButton" Content="EN" Padding="10,7" Click="English_Click"/>
        <Button x:Name="HeaderDarkButton" Content="🌙" ToolTip="Dark mode" Padding="10,7" Click="DarkTheme_Click"/>
        <Button x:Name="HeaderLightButton" Content="☀" ToolTip="Light mode" Padding="10,7" Click="LightTheme_Click"/>
        <Button x:Name="SettingsButton" Click="Settings_Click" Margin="0" MinWidth="104"/>
      </StackPanel>
    </DockPanel>
    <TabControl x:Name="MainTabs" Grid.Row="1" SelectedIndex="0" SelectionChanged="MainTabs_SelectionChanged">
      <!-- 1. PDF -> Images -->
      <TabItem x:Name="PdfToImagesTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconPdfToImagesGeometry}"/>
            <TextBlock x:Name="PdfToImagesTabHeader" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
              <StackPanel>
                <TextBlock x:Name="PdfToImagesTitle" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="PdfToImagesHint" Margin="0,3,0,10" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                <Border Style="{StaticResource CompactDropZone}" Drop="PdfInput_Drop" DragOver="Files_DragOver" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,12,0" Data="{StaticResource IconPdfToImagesGeometry}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="DropPdfText" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="PDF (.pdf)" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="PickPdfButton" Margin="8,0,0,0" Padding="14,6" Click="PickPdf_Click"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="SelectedFileLabel" FontSize="12" Margin="0,0,0,3"/>
                <TextBox x:Name="PdfInputText" Margin="0,0,0,10" IsReadOnly="True"/>
                <TextBlock x:Name="ImageOutputLabel" FontSize="12" Margin="0,0,0,3"/>
                <DockPanel Margin="0,0,0,10">
                  <Button x:Name="PickImageOutputButton" DockPanel.Dock="Right" Click="PickImageOutput_Click"/>
                  <TextBox x:Name="ImageOutputText" IsReadOnly="True"/>
                </DockPanel>
                <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="PngOption" IsChecked="True" Margin="0,0,20,0" Foreground="{DynamicResource TextBrush}"/>
                    <RadioButton x:Name="JpegOption" Foreground="{DynamicResource TextBrush}"/>
                  </StackPanel>
                </Border>
                <Button x:Name="ConvertPdfButton" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Padding="20,9" Click="ConvertPdf_Click"/>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Background="{DynamicResource DropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                  <Button x:Name="PdfToImagesPrevPageButton" Content="◀" Padding="7,3" Click="PdfToImagesPrevPage_Click"/>
                  <TextBlock x:Name="PdfToImagesPageIndicator" VerticalAlignment="Center" Margin="8,0" Text="0 / 0" Foreground="{DynamicResource MutedBrush}"/>
                  <Button x:Name="PdfToImagesNextPageButton" Content="▶" Padding="7,3" Click="PdfToImagesNextPage_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Tag="{Binding ElementName=PdfZoomSlider}" PreviewMouseWheel="Preview_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Grid>
                    <Image x:Name="PdfPreviewImage" Stretch="Uniform" MaxWidth="260" MaxHeight="360">
                      <Image.LayoutTransform><ScaleTransform ScaleX="{Binding ElementName=PdfZoomSlider, Path=Value}" ScaleY="{Binding ElementName=PdfZoomSlider, Path=Value}"/></Image.LayoutTransform>
                    </Image>
                    <TextBlock x:Name="PdfPreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                  <Button Content="−" Padding="9,4" Tag="{Binding ElementName=PdfZoomSlider}" Click="ZoomOut_Click"/>
                  <Slider x:Name="PdfZoomSlider" Width="120" Minimum="0.5" Maximum="4" Value="1" SmallChange="0.1" Margin="4,0,10,0"/>
                  <Button Content="+" Padding="9,4" Tag="{Binding ElementName=PdfZoomSlider}" Click="ZoomIn_Click"/>
                  <TextBlock Width="42" VerticalAlignment="Center" Text="{Binding ElementName=PdfZoomSlider, Path=Value, StringFormat={}{0:P0}}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </TabItem>

      <!-- 2. Images -> PDF -->
      <TabItem x:Name="ImagesToPdfTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconImagesToPdfGeometry}"/>
            <TextBlock x:Name="ImagesToPdfTabHeader" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,18,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="ImagesToPdfTitle" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="ImagesToPdfHint" Grid.Row="1" Margin="0,3,0,8" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
              <Border Grid.Row="2" Style="{StaticResource CompactDropZone}" Drop="Images_Drop" DragOver="Files_DragOver" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Path Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,12,0" Data="{StaticResource IconImagesToPdfGeometry}"/>
                  <TextBlock Grid.Column="1" x:Name="DropImagesText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" x:Name="AddImagesButton" Margin="8,0,0,0" Padding="14,6" Click="AddImages_Click"/>
                </Grid>
              </Border>
              <ListBox Grid.Row="3" x:Name="ImageList" AllowDrop="True" Drop="Images_Drop" DragOver="Files_DragOver" SelectionChanged="ImageList_SelectionChanged"/>
              <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                <Button x:Name="RemoveImageButton" Click="RemoveImage_Click"/>
                <Button x:Name="ImageUpButton" Click="ImageUp_Click"/>
                <Button x:Name="ImageDownButton" Click="ImageDown_Click"/>
                <Button x:Name="ClearImagesButton" Click="ClearImages_Click"/>
                <Button x:Name="CreatePdfButton" Style="{StaticResource PrimaryButton}" Padding="18,9" Click="CreatePdf_Click"/>
              </WrapPanel>
            </Grid>
            <Border Grid.Column="1" Background="{DynamicResource DropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer Tag="{Binding ElementName=ImageZoomSlider}" PreviewMouseWheel="Preview_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Grid>
                    <Image x:Name="ImagePreview" Stretch="Uniform" MaxWidth="260" MaxHeight="400">
                      <Image.LayoutTransform><ScaleTransform ScaleX="{Binding ElementName=ImageZoomSlider, Path=Value}" ScaleY="{Binding ElementName=ImageZoomSlider, Path=Value}"/></Image.LayoutTransform>
                    </Image>
                    <TextBlock x:Name="ImagePreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                  <Button Content="−" Padding="9,4" Tag="{Binding ElementName=ImageZoomSlider}" Click="ZoomOut_Click"/>
                  <Slider x:Name="ImageZoomSlider" Width="120" Minimum="0.5" Maximum="4" Value="1" SmallChange="0.1" Margin="4,0,10,0"/>
                  <Button Content="+" Padding="9,4" Tag="{Binding ElementName=ImageZoomSlider}" Click="ZoomIn_Click"/>
                  <TextBlock Width="42" VerticalAlignment="Center" Text="{Binding ElementName=ImageZoomSlider, Path=Value, StringFormat={}{0:P0}}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </TabItem>

      <!-- 3. Merge PDF -->
      <TabItem x:Name="MergePdfTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconMergePdfGeometry}"/>
            <TextBlock x:Name="MergePdfTabHeader" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,18,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="MergePdfTitle" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="MergePdfHint" Grid.Row="1" Margin="0,3,0,8" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
              <Border Grid.Row="2" Style="{StaticResource CompactDropZone}" Drop="Pdfs_Drop" DragOver="Files_DragOver" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Path Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,12,0" Data="{StaticResource IconMergePdfGeometry}"/>
                  <TextBlock Grid.Column="1" x:Name="DropPdfsText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Button Grid.Column="2" x:Name="AddPdfsButton" Margin="8,0,0,0" Padding="14,6" Click="AddPdfs_Click"/>
                </Grid>
              </Border>
              <ListBox Grid.Row="3" x:Name="PdfList" AllowDrop="True" Drop="Pdfs_Drop" DragOver="Files_DragOver" SelectionChanged="PdfList_SelectionChanged"/>
              <WrapPanel Grid.Row="4" Margin="0,8,0,0">
                <Button x:Name="RemovePdfButton" Click="RemovePdf_Click"/>
                <Button x:Name="PdfUpButton" Click="PdfUp_Click"/>
                <Button x:Name="PdfDownButton" Click="PdfDown_Click"/>
                <Button x:Name="ClearPdfsButton" Click="ClearPdfs_Click"/>
                <Button x:Name="MergePdfsButton" Style="{StaticResource PrimaryButton}" Padding="18,9" Click="MergePdfs_Click"/>
              </WrapPanel>
            </Grid>
            <Border Grid.Column="1" Background="{DynamicResource DropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                  <Button x:Name="MergePrevPageButton" Content="◀" Padding="7,3" Click="MergePrevPage_Click"/>
                  <TextBlock x:Name="MergePageIndicator" VerticalAlignment="Center" Margin="8,0" Text="0 / 0" Foreground="{DynamicResource MutedBrush}"/>
                  <Button x:Name="MergeNextPageButton" Content="▶" Padding="7,3" Click="MergeNextPage_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Tag="{Binding ElementName=MergeZoomSlider}" PreviewMouseWheel="Preview_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Grid>
                    <Image x:Name="MergePreviewImage" Stretch="Uniform" MaxWidth="260" MaxHeight="360">
                      <Image.LayoutTransform><ScaleTransform ScaleX="{Binding ElementName=MergeZoomSlider, Path=Value}" ScaleY="{Binding ElementName=MergeZoomSlider, Path=Value}"/></Image.LayoutTransform>
                    </Image>
                    <TextBlock x:Name="MergePreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                  <Button Content="−" Padding="9,4" Tag="{Binding ElementName=MergeZoomSlider}" Click="ZoomOut_Click"/>
                  <Slider x:Name="MergeZoomSlider" Width="120" Minimum="0.5" Maximum="4" Value="1" SmallChange="0.1" Margin="4,0,10,0"/>
                  <Button Content="+" Padding="9,4" Tag="{Binding ElementName=MergeZoomSlider}" Click="ZoomIn_Click"/>
                  <TextBlock Width="42" VerticalAlignment="Center" Text="{Binding ElementName=MergeZoomSlider, Path=Value, StringFormat={}{0:P0}}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </TabItem>

      <!-- 4. Split PDF (New in v1.4.0) -->
      <TabItem x:Name="SplitPdfTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconSplitPdfGeometry}"/>
            <TextBlock x:Name="SplitPdfTabHeader" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
              <StackPanel>
                <TextBlock x:Name="SplitPdfTitle" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="SplitPdfHint" Margin="0,3,0,10" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                <Border Style="{StaticResource CompactDropZone}" Drop="SplitPdf_Drop" DragOver="Files_DragOver" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,12,0" Data="{StaticResource IconSplitPdfGeometry}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="DropSplitPdfText" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="PDF (.pdf)" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="PickSplitPdfButton" Margin="8,0,0,0" Padding="14,6" Click="PickSplitPdf_Click"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="SplitSelectedFileLabel" FontSize="12" Margin="0,0,0,3"/>
                <TextBox x:Name="SplitPdfInputText" Margin="0,0,0,10" IsReadOnly="True"/>

                <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                  <StackPanel>
                    <TextBlock x:Name="SplitModeLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="SplitAllOption" IsChecked="True" Margin="0,0,20,0" Foreground="{DynamicResource TextBrush}" Checked="SplitMode_Changed"/>
                      <RadioButton x:Name="ExtractRangeOption" Foreground="{DynamicResource TextBrush}" Checked="SplitMode_Changed"/>
                    </StackPanel>
                    <StackPanel x:Name="PageRangePanel" Visibility="Collapsed" Margin="0,8,0,0">
                      <TextBlock x:Name="PageRangeLabel" FontSize="12"/>
                      <TextBox x:Name="PageRangeText" Margin="0,3,0,0" Text="1-3, 5"/>
                      <TextBlock x:Name="PageRangeHint" FontSize="11" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <TextBlock x:Name="SplitOutputLabel" FontSize="12" Margin="0,0,0,3"/>
                <DockPanel Margin="0,0,0,12">
                  <Button x:Name="PickSplitOutputButton" DockPanel.Dock="Right" Click="PickSplitOutput_Click"/>
                  <TextBox x:Name="SplitOutputText" IsReadOnly="True"/>
                </DockPanel>

                <Button x:Name="StartSplitButton" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Padding="20,9" Click="StartSplit_Click"/>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Background="{DynamicResource DropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                  <Button x:Name="SplitPrevPageButton" Content="◀" Padding="7,3" Click="SplitPrevPage_Click"/>
                  <TextBlock x:Name="SplitPageIndicator" VerticalAlignment="Center" Margin="8,0" Text="0 / 0" Foreground="{DynamicResource MutedBrush}"/>
                  <Button x:Name="SplitNextPageButton" Content="▶" Padding="7,3" Click="SplitNextPage_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Tag="{Binding ElementName=SplitZoomSlider}" PreviewMouseWheel="Preview_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Grid>
                    <Image x:Name="SplitPreviewImage" Stretch="Uniform" MaxWidth="260" MaxHeight="360">
                      <Image.LayoutTransform><ScaleTransform ScaleX="{Binding ElementName=SplitZoomSlider, Path=Value}" ScaleY="{Binding ElementName=SplitZoomSlider, Path=Value}"/></Image.LayoutTransform>
                    </Image>
                    <TextBlock x:Name="SplitPreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                  <Button Content="−" Padding="9,4" Tag="{Binding ElementName=SplitZoomSlider}" Click="ZoomOut_Click"/>
                  <Slider x:Name="SplitZoomSlider" Width="120" Minimum="0.5" Maximum="4" Value="1" SmallChange="0.1" Margin="4,0,10,0"/>
                  <Button Content="+" Padding="9,4" Tag="{Binding ElementName=SplitZoomSlider}" Click="ZoomIn_Click"/>
                  <TextBlock Width="42" VerticalAlignment="Center" Text="{Binding ElementName=SplitZoomSlider, Path=Value, StringFormat={}{0:P0}}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </TabItem>

      <!-- 5. Rotate PDF (New in v1.4.0) -->
      <TabItem x:Name="RotatePdfTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconRotatePdfGeometry}"/>
            <TextBlock x:Name="RotatePdfTabHeader" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
              <StackPanel>
                <TextBlock x:Name="RotatePdfTitle" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock x:Name="RotatePdfHint" Margin="0,3,0,10" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                <Border Style="{StaticResource CompactDropZone}" Drop="RotatePdf_Drop" DragOver="Files_DragOver" Margin="0,0,0,10">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Width="22" Height="22" Stretch="Uniform" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="2,0,12,0" Data="{StaticResource IconRotatePdfGeometry}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="DropRotatePdfText" FontSize="14" FontWeight="SemiBold"/>
                      <TextBlock Text="PDF (.pdf)" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="2" x:Name="PickRotatePdfButton" Margin="8,0,0,0" Padding="14,6" Click="PickRotatePdf_Click"/>
                  </Grid>
                </Border>
                <TextBlock x:Name="RotateSelectedFileLabel" FontSize="12" Margin="0,0,0,3"/>
                <TextBox x:Name="RotatePdfInputText" Margin="0,0,0,10" IsReadOnly="True"/>

                <Border Background="{DynamicResource InputBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                  <StackPanel>
                    <TextBlock x:Name="RotateAngleLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <RadioButton x:Name="Rotate90Option" IsChecked="True" Margin="0,0,16,0" Foreground="{DynamicResource TextBrush}" Checked="RotateOption_Changed"/>
                      <RadioButton x:Name="Rotate180Option" Margin="0,0,16,0" Foreground="{DynamicResource TextBrush}" Checked="RotateOption_Changed"/>
                      <RadioButton x:Name="Rotate270Option" Foreground="{DynamicResource TextBrush}" Checked="RotateOption_Changed"/>
                    </StackPanel>

                    <TextBlock x:Name="RotateScopeLabel" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <WrapPanel Orientation="Horizontal">
                      <RadioButton x:Name="RotateAllPagesOption" IsChecked="True" Margin="0,0,14,6" Foreground="{DynamicResource TextBrush}" Checked="RotateScope_Changed"/>
                      <RadioButton x:Name="RotateOddPagesOption" Margin="0,0,14,6" Foreground="{DynamicResource TextBrush}" Checked="RotateScope_Changed"/>
                      <RadioButton x:Name="RotateEvenPagesOption" Margin="0,0,14,6" Foreground="{DynamicResource TextBrush}" Checked="RotateScope_Changed"/>
                      <RadioButton x:Name="RotateCustomPagesOption" Margin="0,0,14,6" Foreground="{DynamicResource TextBrush}" Checked="RotateScope_Changed"/>
                    </WrapPanel>

                    <StackPanel x:Name="RotateCustomRangePanel" Visibility="Collapsed" Margin="0,6,0,0">
                      <TextBlock x:Name="RotateCustomRangeLabel" FontSize="12"/>
                      <TextBox x:Name="RotateCustomRangeText" Margin="0,3,0,0" Text="1, 3-5"/>
                    </StackPanel>
                  </StackPanel>
                </Border>

                <Button x:Name="StartRotateButton" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Padding="20,9" Click="StartRotate_Click"/>
              </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="1" Background="{DynamicResource DropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                  <Button x:Name="RotatePrevPageButton" Content="◀" Padding="7,3" Click="RotatePrevPage_Click"/>
                  <TextBlock x:Name="RotatePageIndicator" VerticalAlignment="Center" Margin="8,0" Text="0 / 0" Foreground="{DynamicResource MutedBrush}"/>
                  <Button x:Name="RotateNextPageButton" Content="▶" Padding="7,3" Click="RotateNextPage_Click"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" Tag="{Binding ElementName=RotateZoomSlider}" PreviewMouseWheel="Preview_MouseWheel" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                  <Grid>
                    <Image x:Name="RotatePreviewImage" Stretch="Uniform" MaxWidth="260" MaxHeight="360">
                      <Image.LayoutTransform>
                        <TransformGroup>
                          <RotateTransform x:Name="RotatePreviewTransform" Angle="0"/>
                          <ScaleTransform ScaleX="{Binding ElementName=RotateZoomSlider, Path=Value}" ScaleY="{Binding ElementName=RotateZoomSlider, Path=Value}"/>
                        </TransformGroup>
                      </Image.LayoutTransform>
                    </Image>
                    <TextBlock x:Name="RotatePreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                  </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                  <Button Content="−" Padding="9,4" Tag="{Binding ElementName=RotateZoomSlider}" Click="ZoomOut_Click"/>
                  <Slider x:Name="RotateZoomSlider" Width="120" Minimum="0.5" Maximum="4" Value="1" SmallChange="0.1" Margin="4,0,10,0"/>
                  <Button Content="+" Padding="9,4" Tag="{Binding ElementName=RotateZoomSlider}" Click="ZoomIn_Click"/>
                  <TextBlock Width="42" VerticalAlignment="Center" Text="{Binding ElementName=RotateZoomSlider, Path=Value, StringFormat={}{0:P0}}"/>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </Border>
      </TabItem>

      <!-- 6. Settings (Accessible via tab or top-right Settings button) -->
      <TabItem x:Name="SettingsTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconSettingsGeometry}"/>
            <TextBlock x:Name="SettingsTabHeader" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
          <StackPanel Width="680" HorizontalAlignment="Left">
            <TextBlock x:Name="SettingsTitle" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="SettingsHint" Margin="0,3,0,18" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
            <TextBlock x:Name="ThemeLabel" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,18">
              <Button x:Name="DarkThemeButton" Style="{StaticResource ChoiceButton}" Click="DarkTheme_Click"/>
              <Button x:Name="LightThemeButton" Style="{StaticResource ChoiceButton}" Click="LightTheme_Click"/>
            </StackPanel>
            <TextBlock x:Name="LanguageLabel" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,18">
              <Button x:Name="ThaiButton" Style="{StaticResource ChoiceButton}" Content="ไทย" Click="Thai_Click"/>
              <Button x:Name="EnglishButton" Style="{StaticResource ChoiceButton}" Content="English" Click="English_Click"/>
            </StackPanel>
            <TextBlock x:Name="DefaultFolderLabel" FontWeight="SemiBold"/>
            <DockPanel Margin="0,5,0,18">
              <Button x:Name="PickDefaultFolderButton" DockPanel.Dock="Right" Click="PickDefaultFolder_Click"/>
              <TextBox x:Name="DefaultFolderText" IsReadOnly="True"/>
            </DockPanel>
            <Button x:Name="SettingsUpdateButton" HorizontalAlignment="Left" Click="CheckUpdate_Click"/>
          </StackPanel>
        </Border>
      </TabItem>

      <!-- 7. About -->
      <TabItem x:Name="AboutTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="14" Height="14" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource IconAboutGeometry}"/>
            <TextBlock x:Name="AboutTabHeader" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Border Style="{StaticResource Panel}" Margin="0,10,0,0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="420"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,28,0">
              <TextBlock x:Name="AboutTitle" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock x:Name="AboutPurposeTitle" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,4"/>
              <TextBlock x:Name="AboutPurposeText" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock x:Name="AboutPrivacyTitle" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,4"/>
              <TextBlock x:Name="AboutPrivacyText" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource MutedBrush}"/>
              <Button x:Name="ProjectPageButton" HorizontalAlignment="Left" Margin="0,18,0,0" Click="ProjectPage_Click"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource DropBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CoffeeTitle" FontSize="18" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock x:Name="CoffeeText" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,10"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,6,0">
                    <Border Background="White" CornerRadius="8" Padding="6"><Image Source="Assets/Support-TrueMoney.png" Height="220" Stretch="Uniform"/></Border>
                    <TextBlock Text="TrueMoney" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,6,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <Border Background="White" CornerRadius="8" Padding="6"><Image Source="Assets/Support-PromptPay.jpeg" Height="220" Stretch="Uniform"/></Border>
                    <TextBlock Text="PromptPay" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,6,0,0"/>
                  </StackPanel>
                </Grid>
                <Button x:Name="CoffeeButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,10,0,0" Click="Coffee_Click"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>
    <Border Grid.Row="2" Margin="0,14,0,0" Padding="12,9" Background="{DynamicResource StatusBrush}" CornerRadius="7">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="GlobalStatus"/>
          <TextBlock x:Name="ProgressText" Margin="0,2,0,0" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
        </StackPanel>
        <ProgressBar x:Name="WorkProgress" Grid.Column="1" Height="8" Margin="12,0" VerticalAlignment="Center" Minimum="0" Maximum="1" Value="0"/>
        <Button x:Name="OpenOutputButton" Grid.Column="2" Click="OpenOutput_Click" Margin="8,0,0,0" Visibility="Collapsed"/>
      </Grid>
    </Border>
  </Grid>
</Window>
