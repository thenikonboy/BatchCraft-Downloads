<Window x:Class="BatchCraft.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BatchCraft 1.4.1" Icon="Assets/BatchCraft.ico"
        Height="760" Width="1100" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <SolidColorBrush x:Key="WindowBrush" Color="#111827"/><SolidColorBrush x:Key="PanelBrush" Color="#1F2937"/>
    <SolidColorBrush x:Key="InputBrush" Color="#273449"/><SolidColorBrush x:Key="TextBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#AAB4C3"/><SolidColorBrush x:Key="BorderBrush" Color="#374151"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6"/><SolidColorBrush x:Key="DropBrush" Color="#17233A"/>
    <SolidColorBrush x:Key="StatusBrush" Color="#182438"/><SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>

    <!-- Vector Path Icon Geometries (16x16 standard) -->
