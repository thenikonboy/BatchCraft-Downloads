<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\BatchCraft.ico</ApplicationIcon>
    <AssemblyName>BatchCraft</AssemblyName>
    <Version>1.4.2</Version>
    <PublishReadyToRun>true</PublishReadyToRun>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm"
                      Version="8.3.2"
                      ExcludeAssets="analyzers" />
    <PackageReference Include="PDFsharp-WPF" Version="6.2.4" />
    <PackageReference Include="PDFtoImage" Version="5.3.0" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>BatchCraft.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\BatchCraft.ico" />
    <Resource Include="Assets\BatchCraft.ico" />
    <Resource Include="Assets\Support-TrueMoney.png" />
    <Resource Include="Assets\Support-PromptPay.jpeg" />
  </ItemGroup>

</Project>
